# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Live API model (streaming ear). Preview model — this is the one that takes audio.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Heavy-lift model for async enrichment (chart structuring, mockup prompts).
GEMINI_MODEL=gemini-3.7-flash

# Image generation (nice-to-have block type)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: real maps route tool. Without it, tools.py returns a canned route.
GOOGLE_MAPS_API_KEY=

WS_HOST=127.0.0.1
WS_PORT=8765

# --- Phone mics (see MICS.md) -----------------------------------------------
# The mic page is served over TLS on this port; phones join at https://<lan-ip>:PORT/
MIC_PORT=8766
MIC_HOST=0.0.0.0
# Tell the model who just took the floor, so it can attribute ideas. 0 to disable.
ANNOUNCE_SPEAKERS=1

# --- Turn detection ---------------------------------------------------------
# The Live model's own VAD works on a real mic but never fires on a replayed PCM
# feed. Set to 1 for `--pcm` rehearsals; leave 0 for a live mic.
MANUAL_ACTIVITY=0

# --- Brain fallbacks --------------------------------------------------------
# Only used by `--brain`, and only if GEMINI_MODEL is unusable at startup (429/503).
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
GEMINI_MODEL_FALLBACK2=gemini-3.5-flash

# Speech gate. Raise if room noise opens mics; lower if quiet talkers are ignored.
# Measure your room with: python backend/mic_level.py
MIC_GATE=0.021
