# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Live API model (streaming ear). Preview model — this is the one that takes audio.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Heavy-lift model for async enrichment (chart structuring, mockup prompts).
GEMINI_MODEL=gemini-3.7-flash

# Image generation (nice-to-have block type)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: real maps route tool. Without it, tools.py returns a canned route.
GOOGLE_MAPS_API_KEY=

WS_HOST=127.0.0.1
WS_PORT=8765

# --- Phone mics (see MICS.md) -----------------------------------------------
# The mic page is served over TLS on this port; phones join at https://<lan-ip>:PORT/
MIC_PORT=8766
MIC_HOST=0.0.0.0
# Tell the model who just took the floor, so it can attribute ideas. 0 to disable.
ANNOUNCE_SPEAKERS=1

# --- Turn detection ---------------------------------------------------------
# The Live model's own VAD works on a real mic but never fires on a replayed PCM
# feed. Set to 1 for `--pcm` rehearsals; leave 0 for a live mic.
MANUAL_ACTIVITY=0

# --- Brain fallbacks --------------------------------------------------------
# Only used by `--brain`, and only if GEMINI_MODEL is unusable at startup (429/503).
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
GEMINI_MODEL_FALLBACK2=gemini-3.5-flash

# Speech gate. Raise if room noise opens mics; lower if quiet talkers are ignored.
# Measure your room with: python backend/mic_level.py
MIC_GATE=0.021

# --- local ears (the DEFAULT ear) -------------------------------------------
# Whisper size: tiny/base/small/medium, or mlx-community/whisper-large-v3-turbo.
# small is the sweet spot on Apple Silicon; large-v3-turbo is noticeably more
# accurate and a ~1.5 GB download.
WHISPER_MODEL=mlx-community/whisper-small-mlx
# Pause that ends an utterance, and the cap on holding a visual back.
EAR_GAP=0.45
EAR_MAX=7.0
# Shortest clip worth transcribing. Do not drop this far: measured, everything
# under ~1s came back as invention rather than speech ("é"; "Thank you." on a
# loop from room hum). Raise it if the room is noisy.
EAR_MIN=1.2
# A full stop only ends a sentence once the line has this many words. Whisper
# punctuates after two words constantly, and a low value here splits one thought
# into three. Lower it only if visuals feel like they lag the room.
EAR_SENTENCE_WORDS=8
# Proper nouns Whisper should expect. Without priming it wrote "Jetson Orin" as
# "GESEL 9-0" and "central question" as "sentry question". Keep it short — it is
# prepended to every transcription. Comma-separated prose is fine.
EAR_VOCAB=Gemini, Gemma, Jetson Orin, multimodal, co-presenter, canvas, latency

# --- responsiveness ---------------------------------------------------------
# How long an UNFINISHED thought may be held waiting for its full stop. Holding to
# EAR_MAX put 9 of 31 utterances at the 7s cap and doubled the median ear wait
# from 2.6s to 5.0s. A thought that has already run this long is worth drawing
# imperfectly. Raise for coherence, lower for responsiveness.
EAR_HOLD_MAX=2.5
# How often the ear looks at its buffer. Transcribe costs ~0.15s so this is pure
# latency, not load.
EAR_TICK=0.1
# Draw from the INTERIM transcript while the speaker is still talking, then refine
# that same block in place when the sentence lands. Roughly halves perceived
# latency at the cost of ~2x calls and an occasional visible correction.
# 0 disables and you get one draw per finished utterance instead.
EAR_SPECULATE=1
EAR_SPEC_WORDS=6
# Only the --live path needs this: its transcripts arrive as overlapping fragments
# that must settle. The local ear hands over whole utterances, which skip it.
BRAIN_DEBOUNCE=0.45

# --- restraint --------------------------------------------------------------
# Content words (excluding grammar) a line needs before it is worth an API call.
# Measured: at the old bar the model drew on 51 of 62 utterances and stayed silent
# ZERO times. This is the free local gate, and the seat a local Gemma salience
# model drops into. Raise it if the board is noisy; lower it if it misses content.
BRAIN_MIN_CONTENT=2
# Seconds a topic keeps the shape it was first drawn as. Below this a request to
# redraw the same key as a different block type is refused, because the audience
# sees the card destroyed and rebuilt. 0 disables.
FORM_LOCK=12.0

# Used when GEMINI_MODEL is too slow to keep up (measured 0.95s vs 25s+ under load).
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# A model slower than this at startup is skipped as unusable for a live talk.
BRAIN_PROBE_TIMEOUT=4.0
